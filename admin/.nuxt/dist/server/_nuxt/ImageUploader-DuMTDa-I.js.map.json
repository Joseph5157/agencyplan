{"file":"ImageUploader-DuMTDa-I.js","mappings":";;;;;;;;;;;AACcA,aAAwB,SAAA,YAAkB;;AASjD,YAAA,OAAAC,eAAAC,WAAA,EAAA,OAAM,eAAW,MAAA,CAAA,CAAA,6MAAA;AAAA;;;;;;;;;","names":["_useModel","_ssrRenderAttrs","_mergeProps"],"sources":["../../../../app/components/ImageUploader.vue"],"sourcesContent":["<script setup lang=\"ts\">\nconst model = defineModel<File | null>({ default: null });\n\nconst onChange = (event: Event) => {\n  const input = event.target as HTMLInputElement;\n  model.value = input.files?.[0] ?? null;\n};\n</script>\n\n<template>\n  <div class=\"space-y-2\">\n    <input\n      type=\"file\"\n      accept=\"image/*\"\n      class=\"block w-full rounded-md border border-slate-300 px-3 py-2 text-sm\"\n      @change=\"onChange\"\n    />\n    <p class=\"text-xs text-slate-500\">Placeholder uploader for upcoming section forms.</p>\n  </div>\n</template>\n\n"],"version":3}